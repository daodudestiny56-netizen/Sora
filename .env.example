# Which engine analyses messages: gemini | openai | rules
# Leave empty to auto-pick: gemini if GEMINI_API_KEY is set, else openai if OPENAI_BASE_URL is set, else rules.
SORA_BACKEND=

# Option A — hosted Gemma 4 through Google's Gemini API (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it
# minimal | low | high
GEMINI_THINKING=minimal

# Option B — local Gemma 4 E4B (or any OpenAI-compatible server). Uncomment to use.
#   ollama pull gemma4:e4b && ollama serve
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=gemma4:e4b

# Voice notes — URL of the YarnGPT2 service in services/voice (e.g. a Hugging Face Space)
VOICE_SERVICE_URL=
VOICE_SERVICE_TOKEN=

# Feature phones — Africa's Talking (https://account.africastalking.com). Use "sandbox" to test.
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
# Number shown to USSD users for the SMS channel
SORA_SMS_NUMBER=

# WhatsApp bot — Twilio (sandbox: https://www.twilio.com/docs/whatsapp/sandbox). See docs/WHATSAPP.md.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Optional: the exact webhook URL configured in Twilio, if signature checks fail behind a proxy
TWILIO_WEBHOOK_URL=
